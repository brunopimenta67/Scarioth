{
  "name": "scarioth",
  "version": "0.1.0",
  "description": "Cross-Exchange Scanner & Arbitrage Engine (Educational)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "start:dev": "npm run build:client && tsx src/index.ts",
    "build:client": "esbuild client/app.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js && tailwindcss -i client/styles.input.css -o public/styles.css",
    "build": "tsc && npm run build:client",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:db": "tsx src/scripts/smoke-db.ts",
    "smoke:ingestion": "tsx src/scripts/smoke-ingestion.ts",
    "smoke:engine": "tsx src/scripts/smoke-engine.ts",
    "smoke:persistence": "tsx src/scripts/smoke-persistence.ts",
    "smoke:api": "tsx src/scripts/smoke-api.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.12",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "mongodb": "^7.9.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
