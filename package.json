{
  "name": "scarioth",
  "version": "0.1.0",
  "description": "Cross-Exchange Scanner & Arbitrage Engine (Educational)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:db": "tsx src/scripts/smoke-db.ts",
    "smoke:ingestion": "tsx src/scripts/smoke-ingestion.ts",
    "smoke:engine": "tsx src/scripts/smoke-engine.ts",
    "smoke:persistence": "tsx src/scripts/smoke-persistence.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "ioredis": "^6.0.0",
    "mongodb": "^7.9.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
